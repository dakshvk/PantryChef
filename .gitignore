# ---------------------------------------------------------------------------
# Secrets. Never commit these. If one is ever committed, rotate the key first
# and treat removal from the working tree as a second, separate step.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Databases and cached third-party API responses.
#
# The SQLite files this project creates hold a `search_cache` table whose
# `response_data` column stores raw Spoonacular responses, and a `favorites`
# table storing whole recipe payloads. Redistributing that content in a public
# repository is a licensing question, not a tidiness one. Databases are build
# artefacts here: they are recreated on first run.
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments. A committed .venv is 200 MB of other people's code
# and platform-specific binaries; it also makes history rewrites expensive.
.venv/
venv/
ENV/
env/
.python-version

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

