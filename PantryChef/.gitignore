# Secrets — never commit. A key in git history stays readable forever,
# even after the file is deleted. Revoke, don't just remove.
.env
.env.*
!.env.example
*.key
credentials.json
secrets.json

# Databases — these cached third-party API responses once, which is
# redistribution of licensed data from a public repo.
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
.vite/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.code-workspace
*.swp
