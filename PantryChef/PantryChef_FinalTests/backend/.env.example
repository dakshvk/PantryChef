# Copy to .env and fill in. .env is gitignored; keep it that way.
#
# If a key ever lands in a commit, revoke it at the provider first and treat
# removing it from the tree as the second step. A key in git history is public
# from the moment the commit is pushed, whether or not the file still exists.

SPOONACULAR_API_KEY=your_spoonacular_key_here
GEMINI_API_KEY=your_gemini_key_here
